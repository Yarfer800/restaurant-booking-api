# Приложение
APP_NAME=Restaurant Booking API
ENVIRONMENT=development
ECHO_SQL=false

# База данных (docker-compose поднимает postgres с этими же параметрами)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/restaurant_booking

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — обязательно поменяйте на рандомную строку в продакшене
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30